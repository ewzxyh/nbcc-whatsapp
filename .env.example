# Copy to .env and set your own private values. Sending is disabled by default.
NBCC_FEED_URL=
GRAPNEL_API_KEY=
GRAPNEL_INSTANCE_ID=
GRAPNEL_GROUP_JID=
GRAPNEL_GROUP_NAME=NBCC Study Group
ADMIN_TOKEN=
WEBHOOK_SECRET=
SEND_ENABLED=false
POLL_INTERVAL=5m
LISTEN_ADDR=:8080
STATE_PATH=/data/state.json
NBCC_BIND_PORT=8080
# Optional: "Course code=Instructor name" pairs separated by semicolons, shown on course activities in /api/agenda.
# COURSE_INSTRUCTORS=
# Optional: built UI directory. Docker already sets /web; uncomment only for local runs.
# WEB_DIR=web/dist
