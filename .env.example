# Set ADMIN_EMAIL before the first account is created. Existing accounts keep their stored e-mail.
# It is fixed for the account lifetime and cannot be changed through the admin UI or API.
ADMIN_EMAIL=admin@example.com
#
# Other application settings are managed in /admin after first-run setup.
# The setup code is printed once in the service log (docker compose logs nbcc).
#
# Legacy settings below are read only once, when settings.json does not exist yet.
# Its values seed the initial settings and are then ignored; later changes belong in /admin.
# Invalid values are skipped and reported by field name only.
#
# Legacy seed variables (all optional):
# NBCC_FEED_URL=
# GRAPNEL_API_KEY=
# GRAPNEL_INSTANCE_ID=
# GRAPNEL_GROUP_JID=
# GRAPNEL_GROUP_NAME=NBCC Study Group
# WEBHOOK_SECRET=
# PUBLIC_BASE_URL=https://nbcc.example.com
# SEND_ENABLED=false
# POLL_INTERVAL=5m
# COURSE_INSTRUCTORS=Linux I=Sample Instructor;Cloud I=Sample Instructor
#
# ADMIN_TOKEN is no longer used and is ignored.
#
# Infrastructure and ADMIN_EMAIL must reach the process environment (Compose loads this file):
# LISTEN_ADDR (default :8080), STATE_PATH (default data/state.json; Docker uses /data/state.json),
# WEB_DIR (default web/dist; Docker uses /web), NBCC_BIND_PORT (compose host port, default 8080).
# TRUSTED_PROXY_IP (optional exact Docker gateway address of the local reverse proxy).
